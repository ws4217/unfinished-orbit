{
  "bgmDefault": 40,
  "sfxDefault": 60,
  "fadeMs": 300,
  "dialogueRatio": 0.7,
  "maxSfxVoices": 4,
  "textIntervalMs": 100,
  "batchLimitBytes": 10485760,
  "tracks": {
    "intro": {
      "asset": "bgm.intro"
    },
    "exploration": {
      "asset": "bgm.sienna-ii"
    },
    "techno": {
      "asset": "bgm.good-old-fashioned-techno"
    },
    "alternate": {
      "asset": "bgm.good-old-fashioned-techno-alternate"
    },
    "valley": {
      "asset": "bgm.the-valley"
    },
    "fleeting": {
      "asset": "bgm.fleeting-colors-1-5x"
    },
    "ending": {
      "asset": "bgm.end-of-journey"
    }
  },
