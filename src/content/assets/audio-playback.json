    "sfx.phone.disconnect": {
      "priority": 75
    },
    "sfx.switch.activate": {
      "priority": 65
    },
    "sfx.switch.deactivate": {
      "priority": 65
    },
    "sfx.button.mechanical": {
      "priority": 40
    },
    "sfx.machine.clean": {
      "priority": 85
    },
    "sfx.gate.activate": {
      "priority": 80
    },
    "sfx.gate.deactivate": {
      "priority": 80
    }
  }
