    "restore": {
      "id": "cycle-restore",
      "speaker": "system",
      "text": "> [..] 恢复基准快照，重新加载世界",
      "warning": false
    },
    "retain": {
      "id": "cycle-restore",
      "speaker": "system",
      "text": "> [..] 清理未登记的临时对象，重新加载世界",
      "warning": false
